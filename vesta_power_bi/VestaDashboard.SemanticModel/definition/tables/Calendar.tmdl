table Calendar
	lineageTag: edf5edc2-d2ae-5add-98e9-5a1302ec9e84

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 018477a8-0d42-5b6e-9e66-aefab30aab38
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	column 'Week Start'
		dataType: dateTime
		formatString: dd mmm
		lineageTag: 9b670e99-1e22-5ce0-921f-a140643e2713
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Start]


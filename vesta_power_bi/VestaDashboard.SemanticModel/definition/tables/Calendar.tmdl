	column Month
		dataType: string
		lineageTag: 60305679-3113-5161-8949-88a5a9f8f0e8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Num'

		annotation SummarizationSetBy = User

	column 'Month Num'
		dataType: int64
		formatString: 0
		lineageTag: 14fe4e82-b52f-5a41-ba25-f784667c3873

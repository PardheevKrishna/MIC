	partition Calendar = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2026, 6, 1), DATE(2026, 10, 31)), "Week Start", [Date] - WEEKDAY([Date], 2) + 1, "Month", FORMAT([Date], "mmm yyyy"), "Month Num", MONTH([Date]))

	annotation PBI_Id = fcd5272ae0a152cb9c1d5333084041ce


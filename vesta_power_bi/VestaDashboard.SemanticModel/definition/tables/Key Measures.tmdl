table 'Key Measures'
	lineageTag: 9a78eff5-82a8-5a5b-921c-b7d59c6d9116

	measure Documents = COUNTROWS(vesta_Document)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 97ea4cd1-68be-5087-a9b9-5fc7dfd4a58a

	measure Versions = COUNTROWS(vesta_DocumentVersion)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: ddda36c3-9b90-5328-8d95-2e617c17ccfb

	measure 'Model Count' = DISTINCTCOUNT(vesta_Document[model_id]) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 50f6cec6-e581-529c-8d91-2e71abe18bd4

	measure 'Multi-Version Documents' = COUNTROWS(FILTER(vesta_Document, CALCULATE(COUNTROWS(vesta_DocumentVersion)) > 1)) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 1a04beb8-b01d-5bb5-be6c-5f223cff0a02

	measure 'Committed Versions' = CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[committed_to_vesta_on])) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 9907c318-438e-57c4-a886-6c52074da01b

	measure 'Published Versions' = CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[published_date])) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: a6565801-0c4e-50d7-ae52-9fb2d47e5c8f

	measure 'Approved Versions' = CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[approved_on])) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 84d2b903-1da9-56ff-bf4f-abf228d55691

	measure 'Commit Rate' = DIVIDE([Committed Versions], [Versions])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: f0f3b03f-2547-5afb-9446-e14c9f985021

	measure 'Draft Share' = DIVIDE(CALCULATE([Versions], vesta_DocumentVersion[state] = "Draft"), [Versions])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: a02dc90b-401d-508e-9428-768a4429f3ab

	measure 'Avg Versions per Document' = DIVIDE([Versions], [Documents])
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: c8d76bfd-4946-50f4-9b3c-a5770197839a

	measure 'Selected Model' = IF(HASONEVALUE('Models'[Model ID]), "Model " & SELECTEDVALUE('Models'[Model ID]), "All models (" & FORMAT([Model Count], "0") & ") - choose a Model ID")
		displayFolder: Labels
		lineageTag: 934a2626-ef02-5343-8029-03d06c14b8cc

	measure 'Selected Model Detail' = IF(HASONEVALUE('Models'[Model ID]), SELECTEDVALUE('Models'[Model Type]) & "  |  " & SELECTEDVALUE('Models'[Risk Tier]) & " risk  |  " & SELECTEDVALUE('Models'[Usage Category]) & "  |  Documents: " & SELECTEDVALUE('Models'[Document Types]), "Portfolio view - search the Model ID dropdown to focus on one model")
		displayFolder: Labels
		lineageTag: 7fbcc14f-31ac-5ef7-984d-889ac8796461

	measure 'Latest State' = VAR v = FILTER(vesta_DocumentVersion, vesta_DocumentVersion[Is Latest]) VAR n = COUNTROWS(v) RETURN IF(n = 0, "-", IF(n <= 2, CONCATENATEX(v, vesta_DocumentVersion[Document Type] & ": " & vesta_DocumentVersion[state], "  /  ", vesta_DocumentVersion[Document Type]), FORMAT(CALCULATE(COUNTROWS(vesta_DocumentVersion), vesta_DocumentVersion[Is Latest], vesta_DocumentVersion[state] = "Draft"), "0") & " docs in Draft"))
		displayFolder: Labels
		lineageTag: ee877653-ace1-5b9e-a40b-447dae77e3ed

	measure 'Latest Version' = VAR v = FILTER(vesta_DocumentVersion, vesta_DocumentVersion[Is Latest]) VAR n = COUNTROWS(v) RETURN IF(n = 0, "-", IF(n <= 2, CONCATENATEX(v, vesta_DocumentVersion[Document Type] & ": " & vesta_DocumentVersion[version_no], "  /  ", vesta_DocumentVersion[Document Type]), FORMAT(n, "0") & " latest versions"))
		displayFolder: Labels
		lineageTag: 297740a7-ce40-5134-93af-76602feaef5e

	measure 'Lifecycle Days' = VAR f = MIN(vesta_DocumentVersion[created_on]) VAR l = MAXX(vesta_DocumentVersion, MAX(vesta_DocumentVersion[created_on], COALESCE(vesta_DocumentVersion[last_modified_on], vesta_DocumentVersion[created_on]))) RETURN IF(ISBLANK(f), BLANK(), DATEDIFF(f, l, DAY))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c9fbeecf-0c87-5918-bca6-3e1bbe8745c0

	measure 'Field Populated' = SWITCH(SELECTEDVALUE('Workflow Field'[Field]), "Last Modified", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[last_modified_on])), "MAR Reference", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[mar_referenceNumber])), "VAR ID", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[var_id])), "Committed to Vesta", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[committed_to_vesta_on])), "MAR ID", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[mar_id])), "Based On Version", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[based_on_version_id])), "Published", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[published_date])), "Approved", CALCULATE(COUNTROWS(vesta_DocumentVersion), NOT ISBLANK(vesta_DocumentVersion[approved_on]))) + 0
		formatString: #,0
		displayFolder: Workflow
		lineageTag: 30c6f393-2813-50b1-9e54-f8ca7624f892

	measure 'Field Coverage %' = DIVIDE([Field Populated], [Versions])
		formatString: 0%
		displayFolder: Workflow
		lineageTag: a7890f13-d2f7-5302-8d0f-f5bf42330442

	column Dummy
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0d6927d8-4ed1-5a2f-a7dd-76022a251b9c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dummy]

		annotation SummarizationSetBy = User

	partition 'Key Measures' = calculated
		mode: import
		source = ROW("Dummy", 0)


	column 'Created Date' = DATE(YEAR(vesta_DocumentVersion[created_on]), MONTH(vesta_DocumentVersion[created_on]), DAY(vesta_DocumentVersion[created_on]))
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: e29bcff5-6801-5256-b040-683922a2a349
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Version Seq' = VAR d = vesta_DocumentVersion[document_id] VAR c = vesta_DocumentVersion[created_on] RETURN COUNTROWS(FILTER(vesta_DocumentVersion, vesta_DocumentVersion[document_id] = d && vesta_DocumentVersion[created_on] <= c))
		dataType: int64
		formatString: 0
		lineageTag: 776c2354-1975-53da-a4e3-5ecea7ff6706
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Is Latest' = vesta_DocumentVersion[created_on] = CALCULATE(MAX(vesta_DocumentVersion[created_on]), ALLEXCEPT(vesta_DocumentVersion, vesta_DocumentVersion[document_id]))
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 71f777dc-7355-5347-9a7c-9fb4b1925a84
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Document Type' = RELATED(vesta_Document[document_type_code])
		dataType: string
		lineageTag: aebfb64d-75dc-549d-9ae2-900d627d29dd
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Model ID' = FORMAT(RELATED(vesta_Document[model_id]), "0")
		dataType: string
		lineageTag: d3822300-b6d7-5dee-ba4e-9e95eca4d809
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'State Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fd35bbf2-65fc-5a8f-8e51-ed0786a653e0
		summarizeBy: none
		sourceColumn: State Order

		annotation SummarizationSetBy = User

	partition vesta_DocumentVersion = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "vesta_DocumentVersion.csv"), [Delimiter = ",", Columns = 27, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlanksToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(BlanksToNull, {{"document_version_id", Int64.Type}, {"document_id", Int64.Type}, {"template_id", Int64.Type}, {"template_version", Int64.Type}, {"version_no", type text}, {"state", type text}, {"based_on_version_id", Int64.Type}, {"created_by", type text}, {"created_on", type datetime}, {"approved_by", type text}, {"approved_on", type datetime}, {"last_modified_by", type text}, {"last_modified_on", type datetime}, {"section_id", type text}, {"template_driver_mapping", type text}, {"mar_id", type text}, {"var_id", type text}, {"committed_to_vesta_by", type text}, {"committed_to_vesta_on", type datetime}, {"var_approverId", type text}, {"var_ReferenceId", type text}, {"published_date", type datetime}, {"published_by", type text}, {"mar_referenceNumber", type text}, {"created_by_name", type text}, {"last_modified_by_name", type text}, {"ack_template_version", Int64.Type}}, "en-US"),
				    StateOrder = Table.AddColumn(Typed, "State Order", each if [state] = "Draft" then 1 else if [state] = "Lock" then 2
				        else if [state] = "Commit to Vesta" then 3 else if [state] = "Publish" then 4 else if [state] = "Retired" then 5 else 9, Int64.Type)
				in
				    StateOrder

	annotation PBI_ResultType = Table

